<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:padding="12dp" android:background="@drawable/widget_bg">

    <ImageButton android:id="@+id/w_talk"
        android:layout_width="60dp" android:layout_height="60dp"
        android:background="@drawable/widget_talk"
        android:src="@drawable/ic_stat_jarvis" android:scaleType="centerInside"
        android:padding="16dp" android:contentDescription="Konuş"/>

    <LinearLayout android:id="@+id/w_text"
        android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical" android:paddingStart="12dp" android:paddingEnd="8dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="T.I.T.U.S." android:textColor="#FFFF3B3B" android:textSize="13sp"
            android:textStyle="bold" android:letterSpacing="0.25"/>
        <TextView android:id="@+id/w_line1"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFFFE5E1" android:textSize="14sp" android:maxLines="2" android:ellipsize="end"
            android:text="Titus hazır"/>
        <TextView android:id="@+id/w_line2"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#FFBF948F" android:textSize="12sp" android:maxLines="1" android:ellipsize="end"
            android:text="Konuşmak için dokun"/>
    </LinearLayout>

    <TextView android:id="@+id/w_brief"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="@drawable/widget_chip" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="6dp" android:paddingBottom="6dp"
        android:text="☀ Brifing" android:textColor="#FFFF9B8F" android:textSize="12sp"/>
</LinearLayout>
